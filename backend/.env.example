# ============================================================
# 智能医疗管家平台 - 环境变量模板
# 复制为 .env 并填写实际值: cp .env.example .env
# 仅列出需要关注的配置项，全部配置及默认值见 backend/app/config.py
# ============================================================

# --- 应用 ---
ENVIRONMENT=development            # development | staging | production（生产强制多项安全默认值）
DEBUG=true                         # 生产环境自动强制关闭
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- 安全（生产环境必填）---
# SECRET_KEY: 生产未配置时拒绝启动；开发未配置时自动生成临时密钥（重启后旧token失效）
SECRET_KEY=change-me-to-a-long-random-string
# 认证中间件: 生产环境强制开启（配置false也会被覆盖为true），开发环境默认关闭
ENABLE_AUTH_MIDDLEWARE=false
# JWT 令牌有效期
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# RBAC 角色权限控制
ENABLE_RBAC=true
METRICS_ACCESS_TOKEN=              # 生产环境必须配置，否则 /metrics 直接404
STARTUP_FAIL_FAST=true             # 生产环境：必需依赖或密钥异常时拒绝启动
RATE_LIMIT_FAIL_CLOSED=false       # 生产环境强制 true：Redis 不可用时拒绝请求而非放行

# --- 限流 ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CALLS=100               # 时间窗口内允许的请求数
RATE_LIMIT_PERIOD=60               # 时间窗口（秒）

# --- 数据库 ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medical_consultation
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medical123

# --- Milvus ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=medical_documents

# --- LLM（硅基流动 SiliconFlow，统一 Provider）---
# 硅基流动提供 Chat / Embedding / Vision 多模态能力，兼容 OpenAI API 格式
# 可用模型列表见: https://siliconflow.cn/models
LLM_PROVIDER=siliconflow
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 对话模型（可选: deepseek-ai/DeepSeek-V3, Qwen/Qwen2.5-72B-Instruct 等）
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
# 嵌入模型（可选: BAAI/bge-large-zh-v1.5, BAAI/bge-m3 等）
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 多模态视觉模型（可选: Qwen/Qwen2.5-VL-72B-Instruct 等）
SILICONFLOW_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# LLM 生成参数与语义缓存
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_MAX_TOKENS=2000
LLM_SEMANTIC_CACHE_ENABLED=true
LLM_SEMANTIC_CACHE_THRESHOLD=0.95

# --- 高级 RAG ---
ENABLE_ADVANCED_RAG=true
ENABLE_MULTI_RETRIEVAL=true
ENABLE_RERANK=true                 # BGE-Reranker 重排序
ENABLE_ML_RERANK=true              # ML 二次排序（需先训练模型，缺模型自动降级）
ENABLE_INTENT_CLASSIFICATION=true  # 意图分类（缺模型自动降级为规则分类）
# 多路召回权重（总和应为1.0）
VECTOR_RETRIEVAL_WEIGHT=0.4
BM25_RETRIEVAL_WEIGHT=0.3
SEMANTIC_RETRIEVAL_WEIGHT=0.2
KG_RETRIEVAL_WEIGHT=0.1

# --- 上下文管理 ---
CONTEXT_MAX_TOKENS=8000
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_HISTORY_LIMIT=10

# --- 对象存储 ---
OBJECT_STORAGE_TYPE=minio          # minio | s3 | oss | local
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=medical-documents
OBJECT_STORAGE_USE_SSL=false

# --- 文件上传 ---
MAX_UPLOAD_SIZE=10485760           # 10MB

# --- 语音（可选，需要 uv sync --extra speech 安装 FunASR）---
ASR_ENABLED=true
ASR_MODEL=paraformer-zh
ASR_DEVICE=cpu                     # cpu | cuda
TTS_ENABLED=true
TTS_ENGINE=edge-tts                # edge-tts | cosyvoice
TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
VOICE_CACHE_TTL=86400              # 语音文件缓存24小时

# --- Langfuse（可选，LLM 追踪观测）---
ENABLE_LANGFUSE=false              # 未配置密钥时建议关闭，避免初始化告警
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- CORS / 可信主机（生产环境改为实际域名）---
# CORS_ORIGINS=["https://app.yourdomain.com"]
# TRUSTED_HOSTS=["api.yourdomain.com","app.yourdomain.com"]
